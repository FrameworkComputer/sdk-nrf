menuconfig DESKTOP_BLE_DISCOVERY_ENABLE
	bool "Bluetooth LE discovery module"
	depends on DESKTOP_BLE_SCAN_ENABLE
	select BT_GATT_DM
	help
	  Enable device to read device description (custom GATT Service),
	  Device Information Service and discover HIDS.

if DESKTOP_BLE_DISCOVERY_ENABLE

config DESKTOP_BLE_DISCOVERY_DEV_DESCR_OPTIONAL
	bool "Accept peers without the device description service"
	help
	  By default, the module disconnects a peer that does not provide the
	  nRF Desktop device description (custom GATT Service). Enable this
	  option to accept such a peer: it is treated as not supporting LLPM
	  and its hardware ID is all zeros.

module = DESKTOP_BLE_DISCOVERY
module-str = BLE discovery
source "subsys/logging/Kconfig.template.log_config"

endif # DESKTOP_BLE_DISCOVERY_ENABLE
